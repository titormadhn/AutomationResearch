*** Keywords ***
the page is showing Sign Up form as an individual account
    Open url staging
    Wait Until Element Is Visible    //a[contains(.,'Get Started with Gherkin Project')]
    Click Element    //a[.='Daftar']
    Sleep    1s

I fill "Nama Lengkap/ Nama Badan Usaha" field "${nama_lengkap}"
    Input Text    id=user_account_name    ${nama_lengkap}
    Sleep    1s

I choose "Daftar Sebagai" radio button as "Perorangan"
    Select Radio Button    user[account_type]    Individual
    Sleep    1s

I select "+62" from the "Kode Negara" Dropdown
    Click Element    //select[@id='user_country_code']
    Click Element   //option[.='+62 (Indonesia)']
    Sleep    1s

i fill "Nomor Telepon" field "${no_tlp}"
    Input Text    id=user_phone_number    ${no_tlp}
    Sleep    1s

i fill "Email" field "${email}"
    Input Text    id=user_email    ${email}
    Sleep    1s 

i select "Kota Bandung" from "Kota/kabupaten" dropdown
    Select From List By Label    id=user_city_code    Kota Bandung
    Sleep    1s

i select "Andir" from "Kecamatan" dropdown
    Wait Until Element Contains    id=user_district_code    Andir
    Select From List By Label    id=user_district_code    Andir
    Sleep    1s 

i fill "Password" field with "${password}"
    Input Text    id=user_password    ${password}
    Sleep    1s 

i fill "Konfirmasi Password" field "${confirm_pswd}"
    Input Text    id=user_password_confirmation    ${confirm_pswd}
    Sleep    2s

i cheklist the chekbox "Saya setuju dengan syarat dan ketentuan yg berlaku"
    Select Checkbox    id=user_toc_confirmation
    Sleep    1s 

i Click "Buat Akun" button
    Click Element    id=submit
    Sleep    1s

i choose "OK" in pop up confirmation "${err_msg}"
    Run Keyword If     '${err_msg}' == 'Email anda sudah terdaftar'    Handle Alert    ACCEPT
    Sleep    2s

i should see error notification "${err_msg}"
    Run Keyword If     '${err_msg}' == 'Email anda sudah terdaftar'    Element Text Should Be    //div[@class='toast toast-error']//div[1]    Email sudah terdaftar    #//div[normalize-space(text())='Email sudah terdaftar']   
     ...     ELSE IF   '${err_msg}' == 'Field nama lengkap / badan usaha minimal 3 character'    Element Text Should Be    //label[@id='user_account_name-error']    Please enter at least 3 characters. 
     ...     ELSE IF   '${err_msg}' == 'Field nomor telepon minimal 7 character'    Element Text Should Be    //label[@id='user_phone_number-error']    Please enter at least 7 characters.
     ...     ELSE IF   '${err_msg}' == 'Field email minimal 10 character'    Element Text Should Be    //label[@id='user_email-error']    Please enter at least 10 characters.    
     ...     ELSE IF   '${err_msg}' == 'Password harus mengandung Uppercase dan Number'    Element Text Should Be    //label[@id='user_password-error']    Password must contain at least one uppercase letter and one number
     ...     ELSE IF   '${err_msg}' == 'Field password minimal 8 character'    Element Text Should Be    //label[@id='user_password-error']    Please enter at least 8 characters.
     ...     ELSE IF   '${err_msg}' == 'Password tidak match'    Element Text Should Be    //label[@id='user_password_confirmation-error']    Please enter the same value again.
     ...     ELSE IF   '${err_msg}' == 'Field harus diisi'    Element Text Should Be    //label[@id='user_account_name-error']    This field is required.
     ...     ELSE    Log To Console    Validasi Belum Lengkap
    Capture Page Screenshot    embed
    Sleep    1s
    Close Browser

