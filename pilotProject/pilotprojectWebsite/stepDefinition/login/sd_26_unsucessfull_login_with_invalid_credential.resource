#Conditional Keyword
verify captcha
    Unselect Frame
    Select Frame    //iframe[@title='recaptcha challenge expires in two minutes']
    Wait Until Element Is Visible    xpath=//*[@id="rc-imageselect"]/div[3]/div[2]/div[1]/div[1]/div[5]
    Click Element    xpath=//*[@id="rc-imageselect"]/div[3]/div[2]/div[1]/div[1]/div[5]
    Sleep    8s
    Unselect Frame
    Select Frame    //iframe[@title='reCAPTCHA']
    Element Attribute Value Should Be    id=recaptcha-anchor    aria-checked    true

SetUp Captcha Valid
    Select Frame    //iframe[@title='reCAPTCHA']
    Wait Until Element Is Visible    id=recaptcha-anchor
    Click Element    id=recaptcha-anchor
    Sleep    8s
    ${condition_captcha}    Get Element Attribute    id=recaptcha-anchor    aria-checked
    Run Keyword If    '${condition_captcha}' == 'false'    verify captcha    # Handle Captcha with condition true/false
    Unselect Frame

#testCase
the user is on the login page again
    Open Browser    https://gherkin-pilot-web.stagingapps.net/    chrome    options=add_argument("--load-extension\=${extension_captcha}")
    Maximize Browser Window
    Sleep    1s

the user enters an invalid email, password, and capthca "${email}" "${password}" "${err_msg}"
    Input Text    id=user_email    ${email}
    Input Text    id=user_password    ${password}
    Run Keyword If    '${err_msg}' == 'email wajib diisi'    SetUp Captcha Valid
    ...  ELSE IF    '${err_msg}' == 'password salah'     SetUp Captcha Valid

clicks the login button again
    Click Element    id=submit
    Sleep    1s

the user should see an error message "${err_msg}"
    Run Keyword If    '${err_msg}' == 'email wajib diisi'     Element Text Should Be    //div[@class='toast-message']    Email dan password wajib diisi
    ...  ELSE IF    '${err_msg}' == 'password salah'    Element Text Should Be    //div[@class='toast-message']    Email atau password salah
    ...  ELSE     Element Text Should Be    //div[@class='toast-message']    Pastikan anda sudah menyelesaikan captcha yang tersedia

the login page should be displayed again
    Capture Page Screenshot    EMBED 
    Page Should Contain Button    id=submit
    Sleep    1s 
    Close Browser

