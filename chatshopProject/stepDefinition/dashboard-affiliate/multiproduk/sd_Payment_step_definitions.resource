#010 - Pembayaran Dengan QRIS
User Pilih Pembayaran QRIS
    Wait Until Page Contains Element    //span[contains(text(),'QR Payments')]
    Scroll Element Into View    //span[contains(text(),'QR Payments')]
    Click Element    //span[contains(text(),'QR Payments')]
    Wait Until Page Contains Element    //canvas[@data-testid='qr-code-canvas']
    Scroll Element Into View    //canvas[@data-testid='qr-code-canvas']
User Scan QRIS
    [Arguments]    ${qr_locator}=//canvas[@data-testid='qr-code-canvas']    ${screenshot_path}=${OUTPUT_DIR}/qr_capture.png
    Wait Until Element Is Visible    ${qr_locator}    timeout=10s
    Capture Page Screenshot    ${screenshot_path}
    ${qr_content}=    Decode QR Code From Image    ${screenshot_path}
    Log To Console    QR Code Content: ${qr_content}
    RETURN    ${qr_content}
User Berhasil Scan QR Dan Diarahkan Ke Halaman Pembayaran Berhasil
    [Arguments]    ${qr_locator}=//canvas[@data-testid='qr-code-canvas']
    ${qr_url}=    User Scan QRIS    ${qr_locator}
    Log To Console    QR Terdeteksi: ${qr_url}
    Wait Until Page Contains Element    //button[contains(normalize-space(.), 'Click here to simulate your payment with')]
    Click Button    //button[contains(normalize-space(.), 'Click here to simulate your payment with')]
    Wait Until Page Contains Element    //h1[normalize-space()='Thank You!']    timeout=15s
    ${order_success}    Get Text    //p[@class='text-center']
    Capture Page Screenshot    EMBED

