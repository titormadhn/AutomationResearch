*** Variables ***
${BTN_EDIT_PERTAMA}            (//button[@title='Edit' or @title='edit' or normalize-space()='edit' or .//*[normalize-space()='edit']])[1]
${INPUT_NAMA_GRUP}             //input[@placeholder='Contoh: Best Seller 2024']
${TEXTAREA_DESKRIPSI}          //textarea[@maxlength='255']
${BANNER_LABEL}                //label[normalize-space()='Banner Grup (Opsional)']
${PRODUK_INFO}                 (//p[@class='text-xs text-slate-400'])[1]
${INPUT_CARI_PRODUK}           //input[@placeholder='Cari berdasarkan nama produk...']
${BTN_SIMPAN_PERUBAHAN}        //button[normalize-space()='Simpan Perubahan']
${BTN_SIMPAN}                  //button[normalize-space()='Simpan']
${BTN_BATAL_MODAL}             (//button[normalize-space()='Batal'])[1]
${ICON_CLOSE_MODAL}            //button[normalize-space()='close' or .//*[normalize-space()='close']]
${LABEL_PILIH_PRODUK}          //label[contains(text(),'Pilih Produk')]    #//label[@class="block text-sm font-medium text-slate-700"]
${PRODUK_SELECTED_FIRST}       (//div[contains(@class,'max-h-64')]//div[contains(@class,'bg-primary-50')])[1]
${PRODUK_UNSELECTED_FIRST}     (//div[contains(@class,'max-h-64')]//div[contains(@class,'cursor-pointer') and not(contains(@class,'bg-primary-50'))])[1]
${ShareLinkAssert}             https://chatshop-stg.stagingapps.net/a/p/4df14f30/TitoR    #ProdukTumblerTest-EdlBaby

*** Keywords ***
#LOCATOR KEY
Back To Main Window
    @{handles}=    Get Window Handles
    Switch Window    ${handles}[0]

Buka Halaman Group Produk
    User Berada Pada Halaman Group Produk
    ${is_popup}=    Run Keyword And Return Status    Wait Until Element Is Visible    ${close_modal_popUp_completeYourProfile}    2s
    IF    ${is_popup}
        Click modalPopUP complete Profile Affiliate
    END

Buka Modal Edit Grup Pertama
    Wait Until Element Is Visible    ${BTN_EDIT_PERTAMA}    20s
    Click Element    ${BTN_EDIT_PERTAMA}

Klik Tombol Simpan Modal Edit
    ${is_simpan_perubahan}=    Run Keyword And Return Status
    ...    Wait Until Element Is Visible    ${BTN_SIMPAN_PERUBAHAN}    5s
    IF    ${is_simpan_perubahan}
        Click Element    ${BTN_SIMPAN_PERUBAHAN}
    ELSE
        Click Element    ${BTN_SIMPAN}
    END

Klik Tombol Batal Modal Edit
    ${is_batal}=    Run Keyword And Return Status
    ...    Wait Until Element Is Visible    ${BTN_BATAL_MODAL}    5s
    IF    ${is_batal}
        Capture Element Screenshot    ${BTN_BATAL_MODAL}    EMBED
        Click Element    ${BTN_BATAL_MODAL}
    ELSE
        Click Element    ${ICON_CLOSE_MODAL}
    END

Input Nama Grup Edit
    [Arguments]    ${nama_grup}
    Wait Until Element Is Visible    ${INPUT_NAMA_GRUP}    10s
    Clear Element Text    ${INPUT_NAMA_GRUP}
    Input Text    ${INPUT_NAMA_GRUP}    ${nama_grup}

Input Deskripsi Edit
    [Arguments]    ${deskripsi}
    Wait Until Element Is Visible    ${TEXTAREA_DESKRIPSI}    10s
    Clear Element Text    ${TEXTAREA_DESKRIPSI}
    Input Text    ${TEXTAREA_DESKRIPSI}    ${deskripsi}

Buka Section Pilih Produk Modal Edit
    Check Locator List Produk
    Wait Until Element Is Visible    ${INPUT_CARI_PRODUK}    10s

Uncheck Satu Produk
    ${is_exist}=    Run Keyword And Return Status
    ...    Element Should Be Visible    ${PRODUK_SELECTED_FIRST}

    IF    ${is_exist}
        Safe Click    ${PRODUK_SELECTED_FIRST}
        Log    Berhasil meng-uncheck 1 produk.
    ELSE
        Log    Tidak ada produk yang sedang dipilih.
    END
    # ${unchecked}=    Run Keyword And Return Status    Safe Click   ${PRODUK_SELECTED_FIRST}
    # IF    not ${unchecked}
    #     ${unchecked_alt}=    Run Keyword And Return Status    Safe Click    ${check_produk_alt}
    #     IF    not ${unchecked_alt}
    #         Safe Click    ${check_produk}
    #     END
    # END

Check Satu Produk
    ${checked}=    Run Keyword And Return Status    Safe Click    ${PRODUK_UNSELECTED_FIRST}
    IF    not ${checked}
        ${checked_alt}=    Run Keyword And Return Status    Safe Click   ${check_produk_alt}
        IF    not ${checked_alt}
            Safe Click    ${check_produk}
        END
    END

Cari Produk Pada Modal Edit
    [Arguments]    ${nama_produk}
    Buka Section Pilih Produk Modal Edit
    Clear Element Text    ${INPUT_CARI_PRODUK}
    Input Text    ${INPUT_CARI_PRODUK}    ${nama_produk}
    Sleep    2s

Error Teks Harus Muncul
    [Arguments]    ${teks1}    ${teks2}=${EMPTY}
    ${ok1}=    Run Keyword And Return Status    Page Should Contain    ${teks1}
    IF    '${teks2}' != ''
        ${ok2}=    Run Keyword And Return Status    Page Should Contain    ${teks2}
        IF    not ${ok1} and not ${ok2}
            Fail    Error tidak ditemukan: ${teks1} / ${teks2}
        END
    ELSE
        IF    not ${ok1}
            Fail    Error tidak ditemukan: ${teks1}
        END
    END
    Capture Element Screenshot    (//p[contains(@class,'text-red-500')])[1]    EMBED

Check PopUp Atur Publik Profile Toko
    ${is_complete_publicprofil_popup}=    Run Keyword And Return Status
    ...    Wait Until Element Is Visible    //h2[@id='modal-title']    3s    #check complete publicprofile
    IF    ${is_complete_publicprofil_popup}
        Click Element    //button[normalize-space()='Nanti']
    END

