# 010 - Unduh QR Code
user unduh QR Code
    SeleniumLibrary.Wait Until Element Is Visible    //button[.//span[normalize-space()='download'] and contains(.,'UNDUH KODE QR')]    3s
    SeleniumLibrary.Click Element    //button[.//span[normalize-space()='download'] and contains(.,'UNDUH KODE QR')]
    Sleep    5s

Verify QR Code Downloaded

    ${card_name}=    SeleniumLibrary.Get Text    xpath=(//h3[contains(@class,'font-bold')])[1]

    Log To Console    Original Card Name: ${card_name}

    ${card_name}=    Replace String
    ...    ${card_name}
    ...    ${SPACE}
    ...    _

    Log To Console    Converted Card Name: ${card_name}

    ${files}=    List Files In Directory    ${folder_download}

    Log To Console    Download Files: ${files}

    ${qr_found}=    Set Variable    ${FALSE}

    ${prefix}=    Set Variable
    ...    QR-${card_name}

    FOR    ${file}    IN    @{files}

        Log To Console    Checking: ${file}

        IF    $file.startswith($prefix) and $file.endswith('.png')

            ${qr_found}=    Set Variable    ${TRUE}

            Log To Console    FOUND: ${file}

            BREAK

        END

    END

    Should Be True    ${qr_found}


# 011 - Akses share link dengan Scan Kode QR  yang baru di-download

Verify And Open QR Downloaded
    ${card_name}=    SeleniumLibrary.Get Text    xpath=(//h3[contains(@class,'font-bold')])[1]

    Log To Console    Original Card Name: ${card_name}

    ${card_name}=    Replace String
    ...    ${card_name}
    ...    ${SPACE}
    ...    _

    Log To Console    Converted Card Name: ${card_name}

    ${files}=    List Files In Directory    ${folder_download}

    ${qr_found}=    Set Variable    ${FALSE}

    ${target_file}=    Set Variable    ${EMPTY}

    ${prefix}=    Set Variable    QR-${card_name}

    FOR    ${file}    IN    @{files}
        Log To Console    Checking: ${file}

        IF    $file.startswith($prefix) and $file.endswith('.png')
            ${qr_found}=    Set Variable    ${TRUE}

            ${target_file}=    Set Variable
            ...    ${folder_download}${/}${file}

            #  untuk memastikan path file sudah benar dan bisa diakses
            ${target_file}=    Normalize Path
            ...    ${target_file}

            Log To Console
            ...    FOUND FILE: ${target_file}

            BREAK
        END
    END

    Should Be True    ${qr_found}

    Log To Console    Opening image...

    Start Process
    ...    explorer.exe
    ...    ${target_file}

    Sleep    5s

