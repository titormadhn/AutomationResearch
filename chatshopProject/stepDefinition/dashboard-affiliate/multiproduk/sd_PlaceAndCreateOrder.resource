Klik Plus By Product Name
    [Arguments]    ${product_name}

    ${plus_locator}=    Set Variable
    ...    //h3[normalize-space()='${product_name}']
    ...    /ancestor::div[contains(@class,'group')]
    ...    //button[.//*[name()='svg' and contains(@class,'lucide-plus')]]

    Wait Until Element Is Visible
    ...    ${plus_locator}
    ...    10s

    Scroll Element Into View
    ...    ${plus_locator}

    # Mouse Over
    # ...    //h3[normalize-space()='${product_name}']
    # ...    /ancestor::div[contains(@class,'group')]

    ${btn}=    Get WebElement
    ...    ${plus_locator}

    Execute Javascript
    ...    arguments[0].click();
    ...    ARGUMENTS
    ...    ${btn}
    

Tambah Produk Otomatis
    ${is_variant}=    Run Keyword And Return Status
    ...    Wait Until Element Is Visible
    ...    xpath=//button[normalize-space()='DETAIL & VARIAN']
    ...    3s

    IF    ${is_variant}
        ${product_name_affiliate}=    Get Text    xpath=//div[.//button[normalize-space()='DETAIL & VARIAN']]//h3

        Set Global Variable    ${product_name_affiliate}

        Log To Console    Product: ${product_name_affiliate}


        Log To Console    Produk dengan VARIAN ditemukan

        ${plus_locator}=    Set Variable    xpath=//div[.//button[normalize-space()='DETAIL & VARIAN']]//button[.//*[local-name()='svg' and contains(@class,'lucide-plus')]][1]

        Wait Until Element Is Visible    ${plus_locator}    5s

        ${btn}=    Get WebElement    ${plus_locator}

        Execute Javascript    arguments[0].click();    ARGUMENTS    ${btn}

        # pilih varian (tunggu varian yang dipilih tampil sebagai border-primary)
        Wait Until Element Is Visible    xpath=//button[contains(@class,'border-primary')]    3s
        ${var_btn}=    Get WebElement    xpath=//button[contains(@class,'border-primary')]
        Execute Javascript    arguments[0].scrollIntoView({block:'center'});    ARGUMENTS    ${var_btn}
        Execute Javascript    arguments[0].click();    ARGUMENTS    ${var_btn}

        # tambah pesanan
        ${added_ok}=    Run Keyword And Return Status    Wait Until Element Is Visible    xpath=//button[contains(normalize-space(.),'Tambah ke Pesanan')]    2s
        IF    ${added_ok}
            ${buy_btn}=    Get WebElement    xpath=//button[contains(normalize-space(.),'Tambah ke Pesanan')]
        ELSE
            ${buy_btn}=    Get WebElement    xpath=//button[contains(normalize-space(.),'Tambah')]
        END

        # pastikan tidak terhalang overlay: scroll ke tengah dan klik via JS
        Execute Javascript    arguments[0].scrollIntoView({block:'center'});    ARGUMENTS    ${buy_btn}
        Sleep    0.5s
        Execute Javascript    arguments[0].click();    ARGUMENTS    ${buy_btn}
        Sleep    1s

        ${is_variant}=    Run Keyword And Return Status
        ...    Page Should Contain Element
        ...    //button[contains(@class,'border-primary')]

        Log To Console    >>> Variant masih ada: ${is_variant}

        Capture Page Screenshot    EMBED

    ELSE

        ${is_detail}=    Run Keyword And Return Status
        ...    Wait Until Element Is Visible
        ...    xpath=//button[normalize-space()='Detail']
        ...    3s

        IF    ${is_detail}
            ${product_name_affiliate}=    Get Text    xpath=//div[.//button[normalize-space()='Detail']]//h3
             Set Global Variable    ${product_name_affiliate}

            Log To Console    Product: ${product_name_affiliate}
            Log To Console    Produk tanpa VARIAN ditemukan

            ${plus_locator}=    Set Variable    xpath=//div[.//button[normalize-space()='Detail']]//button[.//*[local-name()='svg' and contains(@class,'lucide-plus')]][1]

            Wait Until Element Is Visible    ${plus_locator}    5s

            ${btn}=    Get WebElement    ${plus_locator}

            Execute Javascript    arguments[0].click();    ARGUMENTS    ${btn}

        ELSE

            Skip    Tidak ada produk yang dapat ditambahkan

        END
    END
    
