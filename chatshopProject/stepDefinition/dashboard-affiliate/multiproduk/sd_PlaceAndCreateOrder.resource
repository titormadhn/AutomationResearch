#018 - Hapus semua produk di salah satu merchant pada Daftar Paket Pesanan
Close Keranjang
    Wait Until Element Is Visible    (//h2[normalize-space()='Keranjang'])[1]
    Sleep    5s
    Click Element    (//button[@class='p-2 hover:bg-gray-50 rounded-lg transition-colors'])[1]
Tambah Produk Otomatis Kedua
    [Arguments]    ${index}=2
    Close Keranjang
    ${detail_locator}=    Set Variable    xpath=(//button[normalize-space()='Detail' or normalize-space()='DETAIL & VARIAN'])[${index}]
    Wait Until Element Is Visible    ${detail_locator}    3s
    ${btn_text}=    Get Text    ${detail_locator}
    ${is_variant}=    Run Keyword And Return Status
    ...    Should Be Equal As Strings    ${btn_text}    DETAIL & VARIAN
    IF    ${is_variant}
        Log To Console    Produk ke-2 dengan VARIAN ditemukan
        ${detail_btn}=    Get WebElement    ${detail_locator}
        Execute Javascript    arguments[0].scrollIntoView({block:'center'});    ARGUMENTS    ${detail_btn}
        Execute Javascript    arguments[0].click();    ARGUMENTS    ${detail_btn}
        # pilih varian (tunggu varian yang dipilih tampil sebagai border-primary)
        Wait Until Element Is Visible    xpath=//button[contains(@class,'border-primary')]    5s
        ${var_btn}=    Get WebElement    xpath=//button[contains(@class,'border-primary')]
        Execute Javascript    arguments[0].scrollIntoView({block:'center'});    ARGUMENTS    ${var_btn}
        Execute Javascript    arguments[0].click();    ARGUMENTS    ${var_btn}
        # tambah pesanan
        ${added_ok}=    Run Keyword And Return Status    Wait Until Element Is Visible    xpath=//button[contains(normalize-space(.),'Tambah ke Pesanan')]    2s
        IF    ${added_ok}
            ${buy_btn}=    Get WebElement    xpath=//button[contains(normalize-space(.),'Tambah ke Pesanan')]
        ELSE
            ${buy_btn}=    Get WebElement    xpath=//button[contains(normalize-space(.),'Tambah')]
        END
        # pastikan tidak terhalang overlay: scroll ke tengah dan klik via JS
        Execute Javascript    arguments[0].scrollIntoView({block:'center'});    ARGUMENTS    ${buy_btn}
        Sleep    0.5s
        Execute Javascript    arguments[0].click();    ARGUMENTS    ${buy_btn}
        Sleep    1s
        ${still_variant}=    Run Keyword And Return Status
        ...    Page Should Contain Element
        ...    //button[contains(@class,'border-primary')]
        Log To Console    >>> Variant masih ada: ${still_variant}
        Capture Page Screenshot    EMBED
    ELSE
        Log To Console    Produk ke-2 tanpa VARIAN ditemukan
        Click Element    ${detail_locator}
        Wait Until Element Is Visible    //button[contains(text(), 'Tambah')]
        Click Element    //button[contains(text(), 'Tambah')]
    END
