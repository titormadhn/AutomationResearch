User Hapus Semua Produk Di Semua Merchant
    ${element_visible}=    Run Keyword And Return Status    Element Should Be Visible    (//button[@title='Hapus Produk'])[1]
    WHILE    ${element_visible}
        Wait Until Element Is Visible    (//button[@title='Hapus Produk'])[1]
        Click Element    (//button[@title='Hapus Produk'])[1]
        Sleep    1s
        ${element_visible}=    Run Keyword And Return Status    Element Should Be Visible    (//button[@title='Hapus Produk'])[1]
    END